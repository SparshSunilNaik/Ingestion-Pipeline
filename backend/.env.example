# Copy to backend/.env and adjust. All settings are optional.
# IP_DATA_DIR=./data
# IP_LOG_LEVEL=INFO
# IP_LOG_JSON=false

# Repository limits (starting values, not universal truths)
# IP_LIMIT_MAX_ANALYZED_FILES=1000
# IP_LIMIT_MAX_FILE_BYTES=204800
# IP_LIMIT_MAX_TOTAL_SOURCE_BYTES=10485760
# IP_LIMIT_MAX_COMMITS=100
# IP_LIMIT_CLONE_TIMEOUT_SECONDS=180
# IP_LIMIT_MAX_REPO_STORAGE_BYTES=524288000

# OpenCode agent runtime: managed | external | disabled
# IP_OPENCODE_MODE=managed
# IP_OPENCODE_PORT=47900
# IP_OPENCODE_DEFAULT_MODEL=openai/gpt-5.6-terra
# For external mode only (password is never logged or returned by the API):
# IP_OPENCODE_BASE_URL=http://127.0.0.1:4096
# IP_OPENCODE_PASSWORD=
